{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "assets": {
    "directory": "../pkgs/games",
    "binding": "PACK_ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fgc26-local",
      "database_id": "local",
      "migrations_dir": "drizzle"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_LOBBY", "class_name": "MatchLobby" }
    ]
  },
  "migrations": [
    { "tag": "v1-match-lobby", "new_sqlite_classes": ["MatchLobby"] }
  ],
  "vars": {
    "WEB_ORIGIN": "http://localhost:5173",
    "API_ORIGIN": "http://localhost:8787"
  }
}
